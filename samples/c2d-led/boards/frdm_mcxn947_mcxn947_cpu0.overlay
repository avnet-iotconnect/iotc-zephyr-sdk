/*
 * FRDM-MCXN947 Ethernet enablement for the IOTCONNECT telemetry sample.
 *
 * The MCXN947 SoC has an ENET-QoS MAC; the FRDM board wires it (RMII) to an
 * onboard Microchip LAN8741 PHY + RJ45. Zephyr leaves enet_mac/enet_mdio
 * disabled by default, so this overlay turns them on, applies the ENET pinmux,
 * and declares the PHY at MDIO address 0. Modeled on the NXP MCX-Nx4x EVK
 * (same SoC family), which uses the generic "ethernet-phy" driver over RMII.
 *
 * NOTE (hardware-verified, Zephyr v4.4.1): after a WARM reset -- a debugger
 * reset (e.g. right after `west flash`) or the reset pin -- the ENET-QoS MAC
 * fails init with "Can't clear SWR" and Ethernet stays down; the blocking
 * state clears only on a power-on reset. Power-cycle the board (unplug and
 * replug USB) after flashing. Cold boots work. Pulsing the SYSCON ENET module
 * reset and skipping the PHY soft-reset (`no-reset`) were both tested on
 * hardware and do not help; the fix belongs in upstream platform init (see
 * the TODO in Zephyr's eth_nxp_enet_qos.c).
 */

&enet {
	pinctrl-0 = <&pinmux_enet_qos>;
	pinctrl-names = "default";
	status = "okay";
};

&enet_mac {
	status = "okay";
	phy-connection-type = "rmii";
	zephyr,random-mac-address;
	phy-handle = <&phy>;
};

&enet_mdio {
	status = "okay";

	phy: ethernet-phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
		status = "okay";
	};
};
